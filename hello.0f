\ zero word, dword, qword
%zw $0000 ; %zd zw zw ; %zq zd zd ;

\ see man 5 elf

\ 'ELF', then 64bit, LE, v1, sysv
%magic $7F 'ELF ; %machine $02010100 ; %pad zq ;
%e_ident magic machine pad ;

%e_type       $0200 ; 
%e_machine    $3e00 ; 
%e_version    zd ; 
%e_entry      &main ; 
%e_phoff      $4000 zw zd ; 
%e_shoff      zq ; 
%e_flags      zd ; 
%e_ehsize     $4000 ; 
%e_phentsize  $3800 ; 
%e_phnum      $0100 ; 
%e_shentsize  zw ; 
%e_shnum      zw ; 
%e_shstrndx   zw ; 

%elf_header
    e_ident e_type e_machine e_version
    e_entry e_phoff e_shoff e_flags
    e_ehsize e_phentsize e_phnum
    e_shentsize e_shnum e_shstrndx ;
               
%p_type     $0100 zw ;
%p_flags    $0700 zw ;
%p_offset   zq ;
%p_vaddr    zw $4000 zd ;
%p_paddr    zw $4000 zd ;
%p_filesz   !size  ;
%p_memsz    !size  ;
%p_align    $0010 zw zd ;

%phdr p_type p_flags p_offset
      p_vaddr p_paddr p_filesz p_memsz p_align ;

elf_header phdr $00

\ assembly instructions

%nop $90 ;
\ 64bit modifier prefix
%rex $48 ;
%syscall  $0f05 ;

\ move 32bit & 64bit immediate into register

%moveax $b8 ;    %movrax rex moveax ;
%movedx $ba ;    %movrdx rex movedx ;
%movebx $bb ;    %movrbx rex movebx ;
%movebp $bd ;    %movrbp rex movebp ;
%movesi $be ;    %movrsi rex movesi ;
%movedi $bf ;    %movrdi rex movedi ;

\ modify stack pointer
%+sp $83C5 $08 ;
%-sp $83ED $08 ;

%push_b    $6a ;
%push_a    $68 ;

\ system calls
\ RDI, RSI, RDX, RCX, R8, R9 arg order

\ end program
%exit  moveax $3c00 zw
       movedi zd
       syscall ;




\ The first three elements of the stack are stored in RDI, RSI, and RDX.
\ I added a third register because it's fun.
\ RAX is a scrap register.
%push/
    nop
    \ mov [rbp+0x0],rdx
    $48895500
    +sp
    \ mov rdx, rsi
    $4889F2
    \ mov rsi, rdi
    $4889FE
    \ encoding breaks down without this noop
    nop ;

%push/8 push/ movrdi ;
%push/4 push/ movedi ;

\ no stinking loops
%8qw zq zq zq zq zq zq zq zq ;
%1kb 8qw 8qw 8qw 8qw 8qw 8qw 8qw 8qw
      8qw 8qw 8qw 8qw 8qw 8qw 8qw 8qw ;
:stack 8qw 8qw 8qw 8qw

\ 4kb statically allocated. TODO: short dynamic allocator using brk.
:inbuf 1kb

\ 'forth' words
\ Ultimately, I want to write Forth, not assembly.
\ 0f isn't a very powerful language, and I don't want to write an instruction encoder into it.
\ It's meant to be reimplemented in itself, and x86_64 encoding is complex!
\ So, where an instruction will only be used a couple of times, it'll be written in hex with a comment. 


%drop
    \ mov rdi, rsi
    $4889F7
    \ mov rsi, rdx
    $4889D6
    -sp
    \ mov rdx,[rbp+0x0]
    $488B5500 ;

\ mov rdi, rsi
%dup push/ $4889F7 ;
    
\ xchg rsi,rdi
%swap $4887FE ;

\ add rsi, rdi
%+ $4801FE drop ;
\ mov rdi,[rdi]
%@ $488B3F ;

\ mov [rdi], rsi
%! $488937 drop drop ;

\ Calls a syscall with up to 3 arguments, and leaves the return code on the stack. Leaves your parameters, other than your syscall number, untouched. 
%sys/3
    \ "3 parameters ought to be enough for anyone" - bill gates
    \ mov rax, rdi
    $4889F8
    drop
    syscall
    push/
    \ mov rdi, rax
    $4889C7 ;

\ For convenience, we'll define 'strings' as buffer count, not count buffer.
\ This can be modified later by inserting and removing 'swap' invocations.

\ write(1, buf, count)
%.S push/4 $0100 zw dup sys/3 ;

\ read(0, buf, count)
%read push/4 $0000 zw dup sys/3 ;

\ Dealing with sys/3 does my head in. An early iteration of allocation:
\ %alloc push/4 zd brk swap drop + brk ;
\ Eugh.

:base zq
:bump zq

%brk@
    moveax $0c00 zw
    movedi zd
    syscall
    push/
    \ mov rdi, rax
    $4889C7 ;


\ brk(NULL) - gives current segment
\ brk(addr) - increases segment by that amounthell
%brk push/4 $0c00 zw sys/3 ;

\ The stack is pointed to by RBP.
%prelude nop
    movrbp &stack
    brk@ push/8 &base !
    brk@ push/8 &bump !
;

:main
    prelude
    push/4 $0A00 zw
    push/8 &inbuf
    read swap drop swap .S
exit











































