\ zero word, dword, qword
%zw $0000 ; %zd zw zw ; %zq zd zd ;

\ see man 5 elf

\ 'ELF', then 64bit, LE, v1, sysv
%magic $7F 'ELF ; %machine $02010100 ; %pad zq ;
%e_ident magic machine pad ;

%e_type       $0200 ; 
%e_machine    $3e00 ; 
%e_version    zd ; 
%e_entry      &main ; 
%e_phoff      $4000 zw zd ; 
%e_shoff      zq ; 
%e_flags      zd ; 
%e_ehsize     $4000 ; 
%e_phentsize  $3800 ; 
%e_phnum      $0100 ; 
%e_shentsize  zw ; 
%e_shnum      zw ; 
%e_shstrndx   zw ; 

%elf_header
    e_ident e_type e_machine e_version
    e_entry e_phoff e_shoff e_flags
    e_ehsize e_phentsize e_phnum
    e_shentsize e_shnum e_shstrndx ;
               
%p_type     $0100 zw ;
%p_flags    $0700 zw ;
%p_offset   zq ;
%p_vaddr    zw $4000 zd ;
%p_paddr    zw $4000 zd ;
%p_filesz   !size  ;
%p_memsz    !size  ;
%p_align    $0010 zw zd ;

%phdr p_type p_flags p_offset
      p_vaddr p_paddr p_filesz p_memsz p_align ;

elf_header phdr $00

\ With elf out of the way, we can move onto assembly.
\ Register map:
\ RDI: stack[0]
\ RSI: stack[1]
\ RDX: stack[2]
\ RBP: rest of stack pointer
\ RSP: return stack pointer
\ RAX: Scratch register
\ R14: Input buffer
\ R15: Output buffer

%nop $90 ;

\ 64bit modifier prefix
%rex $48 ;
%syscall  $0f05 ;

\ Move 32bit & 64bit immediate into register.
\ These will be trimmed down the line.

%moveax $b8 ;    %movrax rex moveax ;
%movedx $ba ;    %movrdx rex movedx ;
%movebx $bb ;    %movrbx rex movebx ;
%movebp $bd ;    %movrbp rex movebp ;
%movesi $be ;    %movrsi rex movesi ;
%movedi $bf ;    %movrdi rex movedi ;

\ modify stack pointer
%+sp $83C5 $08 ;
%-sp $83ED $08 ;

\ This instruction is widely used in syscalls, to move the return value to TOS
\ mov rdi, rax
%movrdirax $4889C7 ;


\ system calls
\ RDI, RSI, RDX, RCX, R8, R9 arg order

\ end program
%exit  moveax $3c00 zw
       movedi zd
       syscall ;

\ no stinking loops
%8qw zq zq zq zq zq zq zq zq ;



\ Variables.
\ Parameter/data stack.
:stack 8qw 8qw 8qw 8qw
\ Input buffer base.
:inbuf zq
\ Output buffer base.
:outbuf zq
\ Default value of the return stack.
:R0 zq
\ Default value of the system break.
:base zq

\ Name of the file to be written to. 0f uses a.out, so we'll use f.out.
:out 'f.out

\ 'forth' words
\ Ultimately, I want to write Forth, not assembly.
\ 0f isn't a very powerful language, and I don't want to write an instruction encoder.
\ It's meant to be reimplemented in itself, and x86_64 encoding is complex!
\ So, where an instruction will only be used a couple of times, it'll be written in hex with a comment. 
\ Most register to register operations will be written as such, given their use is mostly one-off.

\ The first three elements of the stack are stored in RDI, RSI, and RDX.
\ RAX is a scrap register, because it is used for system calls.
\ push/ is the basis for all other stack operations. It moves RDX to memory, RSI to RDX,
\ and RDU to RSI.
%push/
    nop
    \ mov [rbp],rdx
    $48895500
    +sp
    \ mov rdx, rsi
    $4889F2
    \ mov rsi, rdi
    $4889FE
    \ encoding breaks down without this noop
    nop ;

\ Since it doesn't modify RDI, push/ is dup.
%dup push/ ;

\ For clarity, push/ will be used when rdi is to be overwritten, and dup otherwise.
\ Push an 8 byte or 4 byte immediate.
%push/8 push/ movrdi ;
%push/4 push/ movedi ;

%drop
    \ mov rdi, rsi
    $4889F7
    \ mov rsi, rdx
    $4889D6
    -sp
    \ mov rdx,[rbp+0x0]
    $488B5500 ;


\ xchg rsi,rdi
%swap $4887FE ;

\ These operations are commutative, so it's easy.
\ add rsi, rdi
%+ $4801FE drop ;
\ and rsi,rdi
%and $4821FE drop ;
\ or rsi, rdi 
%or  $4809FE drop ;

\ mov rdi,[rdi]
%@ $488B3F ;
\ mov [rdi], rsi ;
%! $488937 drop drop ;

\ push rdi
%>r $57 drop ;
\ pop rdi
%r> push/ $5F ;

\ Buffer manipulation words.

\ Write single byte to output buffer, then increment.
%o!+b
    \ mov [r15], dil
    $41883F
    \ inc r15
    $49FFC7
    drop ;

\ Fetch single byte from input buffer, then increment.
%i@+b
    push/
    \ movzx rdi, byte [r14]
    $490FB63E
    \ inc r14
    $49FFC6 ;

\ brk(NULL) - gives current segment
\ brk(addr) - increases segment by that amount
%brk
    moveax $0c00 zw
    syscall
    movrdirax ;

%brk@ push/4 zd brk ;
%brk+ brk@ + brk drop ;

\ open(path, flags)
%sys_open moveax $0200 zw syscall movrdirax ;
\ read (fd, buf, count)
%sys_read moveax zd syscall ;
\ fstat (fd, statbuf)
%sys_fstat moveax $0500 zw syscall ;

\ This program doesn't have much error checking. Error checking is large and complex.

\ routine for converting an ascii byte on TOS to hex value
\ adaptation of '(c & 0xF) + 9 * (c >> 6)' - thanks lemire.me!
%h->b
    \ mov eax, edi 
    $89f8
    \ and edi, byte+0xf
    $83e70f
    \ shr eax, byte + 0x6
    $c1e806
    \ mov bl, 0x9
    $b309
    \ mul rbx
    $48f7e3
    \ add edi, eax
    $01c7 ;
    
\ Convert an ASCII representation of a byte from input into a byte in output. 
:atob
    i@+b h->b
    \ shl rdi,byte 0x4
    $48C1E704
    i@+b h->b or
ret

:main
    \ Initialise the datastack pointer.
    movrbp &stack
    \ Open argv[1] for reading(0x0 - 0_RDONLY)
    movesi zd
    \ Get the first argument from the system stack.
    \ It is the return stack pointer henceforth.
    \ mov rdi, [rsp+0x10]
    $488B7C2410
    sys_open 
    \ Allocate space for the fstat struct.
    brk@ swap push/4 $9000 zw brk+
    sys_fstat
    swap
    \ 0x30 bytes offset from fstat structure is the file length. Retrieve it,
    push/4 $3000 zw + @
    \ and allocate memory of that length to act as the input buffer.
    dup brk@ swap brk+ 
    \ current stack at this point is  buf, count, fd(0x3)

    \ Initialise input buffer register and variable.
    \ mov r14,rdi
    $4989fe
    dup push/8 &inbuf !
    push/4 $0300 zw
    sys_read
    \ Allocate space for the output buffer - 5kb. Conservative estimate.
    brk@ push/4 $0014 zw brk+
    \ Initialise output buffer register and variable.
    \ mov r15,rdi
    $4989ff
    push/8 &outbuf ! 
    
exit











































