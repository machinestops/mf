\ zero word, dword, qword
%zw $0000 ; %zd zw zw ; %zq zd zd ;

\ see man 5 elf

\ 'ELF', then 64bit, LE, v1, sysv
%magic $7F 'ELF ; %machine $02010100 ; %pad zq ;
%e_ident magic machine pad ;

%e_type       $0200 ; 
%e_machine    $3e00 ; 
%e_version    zd ; 
%e_entry      &main ; 
%e_phoff      $4000 zw zd ; 
%e_shoff      zq ; 
%e_flags      zd ; 
%e_ehsize     $4000 ; 
%e_phentsize  $3800 ; 
%e_phnum      $0100 ; 
%e_shentsize  zw ; 
%e_shnum      zw ; 
%e_shstrndx   zw ; 

%elf_header
    e_ident e_type e_machine e_version
    e_entry e_phoff e_shoff e_flags
    e_ehsize e_phentsize e_phnum
    e_shentsize e_shnum e_shstrndx ;
               
%p_type     $0100 zw ;
%p_flags    $0700 zw ;
%p_offset   zq ;
%p_vaddr    zw $4000 zd ;
%p_paddr    zw $4000 zd ;
%p_filesz   !size  ;
%p_memsz    !size  ;
%p_align    $0010 zw zd ;

%phdr p_type p_flags p_offset
      p_vaddr p_paddr p_filesz p_memsz p_align ;

elf_header phdr $00

\ assembly instructions

%nop $90 ;
\ 64bit modifier prefix
%rex $48 ;
%syscall  $0f05 ;

\ move 32bit & 64bit immediate into register

%moveax $b8 ;    %movrax rex moveax ;
%movedx $ba ;    %movrdx rex movedx ;
%movebx $bb ;    %movrbx rex movebx ;
%movebp $bd ;    %movrbp rex movebp ;
%movesi $be ;    %movrsi rex movesi ;
%movedi $bf ;    %movrdi rex movedi ;

%addrbp_b  rex $83C5 ;
%subrbp_b  rex $83ED ;

%+sp addrbp_b $08 ;
%-sp subrbp_b $08 ;

%push_b    $6a ;
%push_a    $68 ;
%movedx,eax $89C2 ;


\ system calls
\ RDI, RSI, RDX, RCX, R8, R9 arg order
\ sys_write (fd, buf, count) <- rdi, rsi, rdx
\ read(fd, buf, count)
\ RDI is TOS RSI is 2OS stack in EBP

%exit  moveax $3c00 zw
       movedi zd
       syscall ;

%brk moveax $0c00 zw
     movedi zd 
     syscall ;


\ The first three elements of the stack are stored in RDI, RSI, and RDX.
\ The rest are stored in the pointer pointed to by RBP. 
\ I added a third register because it's fun.
%prelude nop movrbp &stack ;
%push/
    nop
    \ mov [rbp+0x0],rdx
    $48895500
    +sp
    \ mov rdx, rsi
    $4889F2
    \ mov rsi, rdi
    $4889FE
    \ encoding breaks down without this noop
    nop ;

%push/8 push/ movrdi ;
%push/4 push/ movedi ;


\ no stinking loops
%8qw zq zq zq zq zq zq zq zq ;
%1kb 8qw 8qw 8qw 8qw 8qw 8qw 8qw 8qw
      8qw 8qw 8qw 8qw 8qw 8qw 8qw 8qw ;
:stack 8qw 8qw 8qw 8qw

\ 4kb statically allocated. TODO: short dynamic allocator using brk.
:inbuf 8qw
\ 1kb 1kb 1kb 1kb

\ 'forth' words
\ Ultimately, I want to write Forth, not assembly.

%drop
    \ mov rdi, rsi
    $4889F7
    \ mov rsi, rdx
    $4889D6
    -sp
    \ mov rdx,[rbp+0x0]
    $488B5500 
     ;

%swap
    \ xchg rsi,rdi
    $4887FE ;

%sys/3
    \ "3 parameters ought to be enough for anyone" - bill gates
    \ mov rax, rdi
    $4889F8
    drop
    syscall
    push/
    \ mov rdi, rax
    $4889C7
    ;
    


:buf 'Hello $0A

:main
    prelude
    push/4 $0600 zw
    push/8 &buf
    \ 0x1 - stdout
    push/4 $0100 zw
    \ 0x1 - sys_write
    push/4 $0100 zw
    sys/3
exit











































